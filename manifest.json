{
  "manifest_version": 3,
  "name": "LinkedIn AI Post Filter",
  "version": "1.0.0",
  "description": "Hides or blurs likely AI-generated posts in your LinkedIn feed.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn AI Filter"
  }
}
